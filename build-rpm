#!/bin/bash
#
# Build RPM
#
# @author Jun Futagawa (jfut)

set -euo pipefail

export LC_ALL=C

# Generate a self-contained bundle with uv and PyInstaller during the RPM build.
BUILD_PACKAGES=(autoconf automake libtool gcc make gnupg2 rpm-build rpm-sign rpmdevtools systemd-rpm-macros)
MAX_RETRY="10"
UV_VERSION="0.11.32"

if [[ $# -lt 2 ]]; then
    echo "$0" RPMBUILD_DIR SPEC_FILE_NAME
    exit 1
fi

RPMBUILD_DIR="${1}"
SPEC_FILE_NAME="${2}"

pushd "${RPMBUILD_DIR}"
mkdir -p SOURCES

install_uv() {
    if command -v uv >/dev/null 2>&1; then
        return
    fi

    # Install uv only in the build environment; it is not included in the RPM.
    curl --fail --silent --show-error --location \
        "https://astral.sh/uv/${UV_VERSION}/install.sh" | \
        UV_INSTALL_DIR=/usr/local/bin sh
}

# RPM macros
RPM_MACROS=/usr/lib/rpm/macros.d/macros.dist
if [[ -f /etc/rpm/macros.dist ]]; then
    # el8
    RPM_MACROS=/etc/rpm/macros.dist
fi
RPM_DIST=".$(grep -E -o "^%el[0-9]*" "${RPM_MACROS}" | tr -d '%')"
echo "RPM_DIST: ${RPM_DIST} (${RPM_MACROS})"

sign_rpms() {
    local passfile
    local public_key_file
    local gpg_fingerprint="${GPG_FINGERPRINT:-}"
    local secret_key_count
    local imported_secret_fingerprint

    cleanup_signing_passfile() {
        rm -f "${passfile:-}"
        rm -f "${public_key_file:-}"
    }

    : "${GPG_KEY_PATH:?GPG_KEY_PATH is required when SIGN_RPMS=yes}"
    : "${GPG_PASSPHRASE:?GPG_PASSPHRASE is required when SIGN_RPMS=yes}"

    mkdir -p "${HOME}/.gnupg"
    chmod 700 "${HOME}/.gnupg"

    # Allow rpmsign to pass the passphrase to gpg in non-interactive builds.
    cat <<'EOF' > "${HOME}/.gnupg/gpg-agent.conf"
allow-loopback-pinentry
EOF

    gpg --batch --import "${GPG_KEY_PATH}"
    gpg-connect-agent reloadagent /bye

    # Auto-select the only imported secret key when the caller did not
    # specify one explicitly.
    if [[ -z "${gpg_fingerprint}" ]]; then
        secret_key_count="$(
            gpg --batch --with-colons --list-secret-keys 2>/dev/null | \
                awk -F: '/^sec:/ { count++ } END { print count + 0 }'
        )"
        if [[ "${secret_key_count}" -gt 1 ]]; then
            echo "Multiple secret keys are available. Set GPG_FINGERPRINT explicitly." >&2
            gpg --batch --list-secret-keys --keyid-format long >&2 || true
            exit 1
        fi
    fi

    # Resolve the actual secret key fingerprint visible in the container so
    # rpmsign uses a key identifier that gpg can sign with.
    if [[ -n "${gpg_fingerprint}" ]]; then
        imported_secret_fingerprint="$(
            gpg --batch --with-colons --list-secret-keys "${gpg_fingerprint}" 2>/dev/null | \
                awk -F: '
                    /^sec:/ || /^ssb:/ { want_fpr=1; next }
                    want_fpr && /^fpr:/ { print $10; exit }
                '
        )"
    else
        imported_secret_fingerprint="$(
            gpg --batch --with-colons --list-secret-keys 2>/dev/null | \
                awk -F: '
                    /^sec:/ || /^ssb:/ { want_fpr=1; next }
                    want_fpr && /^fpr:/ { print $10; exit }
                '
        )"
    fi
    if [[ -z "${imported_secret_fingerprint}" ]]; then
        echo "Failed to find an imported secret key for rpmsign." >&2
        gpg --batch --list-secret-keys --keyid-format long >&2 || true
        exit 1
    fi

    passfile="$(mktemp)"
    public_key_file="$(mktemp)"
    chmod 600 "${passfile}"
    # Remove the temporary passphrase file even when signing fails midway.
    trap cleanup_signing_passfile RETURN
    printf '%s' "${GPG_PASSPHRASE}" > "${passfile}"

    # rpm --checksig verifies against the RPM database, not the GnuPG keyring.
    gpg --batch --armor --export "${imported_secret_fingerprint}" > "${public_key_file}"
    rpm --import "${public_key_file}"

    # Configure rpmsign to use the imported key during automated builds.
    cat <<EOF > "${HOME}/.rpmmacros"
%_gpg_name ${imported_secret_fingerprint}
%_gpg_sign_cmd_extra_args --batch --pinentry-mode loopback --no-tty --passphrase-file ${passfile}
EOF

    while IFS= read -r -d '' rpm_file; do
        # Skip files that already carry an rpm signature.
        if rpm -qp --qf '%{OPENPGP} %{SIGPGP} %{SIGGPG} %{RSAHEADER} %{DSAHEADER}\n' "${rpm_file}" 2>/dev/null | \
            grep -Fvq '(none) (none) (none) (none) (none)'; then
            echo "Skipping already signed RPM: ${rpm_file}"
            continue
        fi

        # Sign each rpm individually so any failing package stops the build.
        rpmsign --addsign "${rpm_file}"
        rpm --checksig "${rpm_file}"
    done < <(find RPMS SRPMS -type f -name "*${RPM_DIST}*.rpm" -print0)

    trap - RETURN
    cleanup_signing_passfile
}

# install dependencies
echo
echo "Installing build tools and dependencies: ${BUILD_PACKAGES[*]} dnf-plugins-core"
INSTALL_RETRY=0
until dnf -y install "${BUILD_PACKAGES[@]}" dnf-plugins-core || [[ "${INSTALL_RETRY}" -eq "${MAX_RETRY}" ]];
do
    echo
    sleep $((INSTALL_RETRY++))
    echo "Retry: dnf -y install ${BUILD_PACKAGES[*]} (retry: ${INSTALL_RETRY})"
done
install_uv
BUILDDEP_RETRY=0
until dnf -y builddep "SPECS/${SPEC_FILE_NAME}" || [[ "${BUILDDEP_RETRY}" -eq "${MAX_RETRY}" ]];
do
    sleep $((BUILDDEP_RETRY++))
    echo
    echo "Retry: dnf -y builddep \"SPECS/${SPEC_FILE_NAME}\" (retry: ${BUILDDEP_RETRY})"
done

# build rpm
if [[ "${RPM_DIST}" = ".el8" ]]; then
    # el8
    spectool -g -A "SPECS/${SPEC_FILE_NAME}" -C SOURCES/
else
    # el9 or later
    spectool -g -a "SPECS/${SPEC_FILE_NAME}" -C SOURCES/
fi

echo "Building RPM"
rpmbuild \
    --define "%_topdir ${RPMBUILD_DIR}" \
    --define "%dist ${RPM_DIST}" \
    -ba "SPECS/${SPEC_FILE_NAME}"

if [[ "${SIGN_RPMS:-no}" = "yes" ]]; then
    # Sign the generated RPMs in the same distro environment used for the build.
    sign_rpms
fi

popd
